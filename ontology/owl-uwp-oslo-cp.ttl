schemas:identifier owl:equivalentProperty schema:identifier .

schemas:image owl:equivalentProperty schema:image .

schemas:description owl:equivalentProperty schema:description .

schemas:email owl:equivalentProperty schema:email .

schemas:telephone owl:equivalentProperty schema:telephone .

