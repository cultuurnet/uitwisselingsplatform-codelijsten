@prefix cp: <https://data.vlaanderen.be/ns/cultuurparticipatie#> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix m8g: <http://data.europa.eu/m8g/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix uwp: <https://data.uitwisselingsplatform.be/ns/platform#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cidoc: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schemas: <https://schema.org/> .
@prefix schema: <http://schema.org/> .
@prefix generiek: <https://data.vlaanderen.be/ns/generiek#> .
@prefix gebouw: <https://data.vlaanderen.be/ns/gebouw#> .
@prefix infrastr: <https://data.vlaanderen.be/ns/cultuur-en-jeugd/infrastructuur#> .
@prefix uitpas: <https://data.publiq.be/ns/uitpas#> .
@prefix museumpas: <https://data.publiq.be/ns/museumpassmusees#> .
@base <http://www.w3.org/2002/07/owl#> .

<> rdf:type owl:Ontology ;
   owl:versionInfo "2026-05-18" ;
   rdfs:label "UWP OSLO Cultuurparticipatie ontology"@nl ;
   rdfs:comment "Phase 1-afstemming met instance-data gap-analyse (2026-05-18)."@nl .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2002/07/owl#maxCardinality
owl:maxCardinality rdf:type owl:AnnotationProperty ;
                   rdfs:comment "Annotatie-eigenschap die het maximum aantal waarden voor een eigenschap aangeeft."@nl ;
                   rdfs:label "maximum kardinaliteit"@nl .


###  http://www.w3.org/2002/07/owl#minCardinality
owl:minCardinality rdf:type owl:AnnotationProperty ;
                   rdfs:comment "Annotatie-eigenschap die het minimum aantal waarden voor een eigenschap aangeeft."@nl ;
                   rdfs:label "minimum kardinaliteit"@nl .


###  http://www.w3.org/2004/02/skos/core#scopeNote
skos:scopeNote rdf:type owl:AnnotationProperty ;
               rdfs:comment "Nota die helpt de betekenis en/of het gebruik van een concept te verduidelijken."@nl ;
               rdfs:label "toepassingsnota"@nl .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:ObjectProperty ;
                rdfs:domain adms:Identifier ;
                rdfs:range foaf:Agent ;
                rdfs:comment "Link naar de agent die de identificator heeft uitgegeven. URI met OVO-code van de organisatie"@nl ;
                rdfs:label "toegekend door"@nl ;
                owl:maxCardinality 1 ;
                owl:minCardinality 1 .


###  http://purl.org/dc/terms/isVersionOf
dcterms:isVersionOf rdf:type owl:ObjectProperty ;
                    rdfs:domain adms:Identifier ;
                    rdfs:range adms:Identifier ;
                    rdfs:comment "Een verwijzing naar een andere versie van de identificator."@nl ;
                    rdfs:label "is versie van"@nl .


###  http://purl.org/dc/terms/type
dcterms:type rdf:type owl:ObjectProperty ;
             rdfs:domain dcterms:Location ,
                         cidoc:E7_Activity ,
                         cp:AlgemeenParticipantKenmerk ,
                         cp:Deelname ,
                         cp:Realisator ;
             rdfs:range skos:Concept ;
             rdfs:comment "Het type van activiteit."@nl ;
             rdfs:label "type"@nl ;
             owl:maxCardinality 1 .


###  http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by
cidoc:P14_carried_out_by rdf:type owl:ObjectProperty ;
                         rdfs:domain cidoc:E7_Activity ;
                         rdfs:range cp:Realisator ;
                         rdfs:comment "De Activiteit wordt uitgevoerd door een Realisator."@nl ;
                         rdfs:label "gerealiseerd door"@nl .


###  http://www.cidoc-crm.org/cidoc-crm/P160_has_temporal_projection
cidoc:P160_has_temporal_projection rdf:type owl:ObjectProperty ;
                                   rdfs:domain cidoc:E92_Spacetime_Volume ;
                                   rdfs:range m8g:PeriodOfTime ;
                                   rdfs:comment "Verbindt een ruimtetijd-volume met een tijdsperiode."@nl ;
                                   rdfs:label "heeft temporele projectie"@nl .


###  http://www.cidoc-crm.org/cidoc-crm/P161_has_spatial_projection
cidoc:P161_has_spatial_projection rdf:type owl:ObjectProperty ;
                                  rdfs:domain cidoc:E92_Spacetime_Volume ;
                                  rdfs:range dcterms:Location ;
                                  rdfs:comment "Verbindt een ruimtetijd-volume met een locatie."@nl ;
                                  rdfs:label "heeft ruimtelijke projectie"@nl .


###  http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span
cidoc:P4_has_time-span rdf:type owl:ObjectProperty ;
                       rdfs:domain cidoc:E7_Activity ;
                       rdfs:range m8g:PeriodOfTime ;
                       rdfs:comment "Tijdstip wanneer de activiteit zal plaatsvinden of heeft plaatsgevonden."@nl ;
                       skos:scopeNote "Het is enkel mogelijk om ofwel cidoc:P4_has_time-span & prov:atLocation te gebruiken voor Activiteiten met één aanduiding in tijd & ruimte ofwel Activiteit.ruimtetijd voor meerdere aanduidingen. Beide gebruiken is niet mogelijk."@nl ;
                       rdfs:label "tijd"@nl ;
                       owl:maxCardinality 1 .


###  http://www.w3.org/2004/02/skos/core#exactMatch
skos:exactMatch rdf:type owl:ObjectProperty ;
                rdfs:domain skos:Concept ;
                rdfs:range skos:Concept ;
                rdfs:comment "Verwijst naar een concept met dezelfde betekenis in een ander schema. Wordt gebruikt om de taxonomie van UiTdatabank te mappen op de officiele codelijsten van het UiTwisselingsplatform."@nl ;
                rdfs:label "exacte overeenkomst"@nl .


###  http://www.w3.org/2004/02/skos/core#inScheme
skos:inScheme rdf:type owl:ObjectProperty ;
              rdfs:domain skos:Concept ;
              rdfs:range skos:ConceptScheme ;
              rdfs:comment "Geeft aan tot welk conceptschema een concept behoort."@nl ;
              rdfs:label "in schema"@nl .


###  http://www.w3.org/ns/adms#identifier
adms:identifier rdf:type owl:ObjectProperty ;
                rdfs:domain dcterms:Location ,
                            cidoc:E7_Activity ,
                            cp:Organisator ,
                            cp:Participant ,
                            cp:Uitvoerder ;
                rdfs:range adms:Identifier ;
                rdfs:comment "Een unieke identificator voor de entiteit."@nl ;
                rdfs:label "identificator"@nl ;
                owl:maxCardinality 1 ;
                owl:minCardinality 1 .


###  http://www.w3.org/ns/locn#address
locn:address rdf:type owl:ObjectProperty ;
             rdfs:domain dcterms:Location ,
                         cp:Organisator ;
             rdfs:range locn:Address ;
             rdfs:comment "Het adres van de entiteit."@nl ;
             rdfs:label "adres"@nl .


###  http://www.w3.org/ns/locn#geometry
locn:geometry rdf:type owl:ObjectProperty ;
              rdfs:domain dcterms:Location ,
                          foaf:Agent ;
              rdfs:range locn:Geometry ;
              rdfs:comment "De geometrie van de entiteit."@nl ;
              rdfs:label "geometrie"@nl .


###  http://www.w3.org/ns/prov#atLocation
prov:atLocation rdf:type owl:ObjectProperty ;
                rdfs:domain cidoc:E7_Activity ;
                rdfs:range dcterms:Location ;
                rdfs:comment "Aanduiding van een geografische positie, dmv coordinaten, een toponiem, een adreslabel, een verwijzing naar een plaats/regio of verwijzing naar een adres."@nl ;
                skos:scopeNote "Dit datatype mag gesubstitueerd worden door om het even welk ander dat een geografische positie aanduidt, direct of indirect. Het is enkel mogelijk om ofwel cidoc:P4_has_time-span & prov:atLocation te gebruiken voor Activiteiten met één aanduiding in tijd & ruimte ofwel Activiteit.ruimtetijd voor meerdere aanduidingen. Beide gebruiken is niet mogelijk."@nl ;
                rdfs:label "locatie"@nl ;
                owl:maxCardinality 1 .


###  https://data.uitwisselingsplatform.be/ns/platform#bron
uwp:bron rdf:type owl:ObjectProperty ;
         rdfs:domain adms:Identifier ;
         rdfs:comment "URI van de bron in beheer van de agent die de identificator heeft uitgegeven. Gebaseerd op de naam van het dataproduct in het UiTwisselingsplatform"@nl ;
         rdfs:label "bron"@nl ;
         owl:maxCardinality 1 ;
         owl:minCardinality 1 .


###  https://data.uitwisselingsplatform.be/ns/platform#ticketBeschikbaarheid
uwp:ticketBeschikbaarheid rdf:type owl:ObjectProperty ;
                          rdfs:domain cp:Beschikbaarheid ;
                          rdfs:range skos:Concept ;
                          rdfs:comment "Beschikbaarheid van tickets voor een activiteit, uitgedrukt als concept."@nl ;
                          rdfs:label "ticketbeschikbaarheid"@nl .


###  https://data.uitwisselingsplatform.be/ns/platform#virtueleLocatie
uwp:virtueleLocatie rdf:type owl:ObjectProperty ;
                    rdfs:domain cidoc:E7_Activity ;
                    rdfs:range schemas:VirtualLocation ;
                    rdfs:comment "De virtuele locatie waar de Activiteit plaatsvindt. sub-property van schema:location. Te gebruiken in combinatie met Activiteit.locatietype online of hybride"@nl ;
                    rdfs:label "virtuele locatie"@nl ;
                    owl:maxCardinality 1 .


###  https://data.vlaanderen.be/ns/cultuurparticipatie#Activiteit.beschikbaarheid
cp:Activiteit.beschikbaarheid rdf:type owl:ObjectProperty ;
                              rdfs:domain cidoc:E7_Activity ;
                              rdfs:range cp:Beschikbaarheid ;
                              rdfs:comment "Geeft de beschikbaarheid weer van de Activiteit."@nl ;
                              rdfs:label "beschikbaarheid"@nl ;
                              owl:maxCardinality 1 .


###  https://data.vlaanderen.be/ns/cultuurparticipatie#Activiteit.boeking
cp:Activiteit.boeking rdf:type owl:ObjectProperty ;
                      rdfs:domain cidoc:E7_Activity ;
                      rdfs:range cp:Boekingsinfo ;
                      rdfs:comment "De Boekinginfo van de Activiteit."@nl ;
                      rdfs:label "boeking"@nl ;
                      owl:maxCardinality 1 .


###  https://data.vlaanderen.be/ns/cultuurparticipatie#Activiteit.contactinfo
cp:Activiteit.contactinfo rdf:type owl:ObjectProperty ;
                          rdfs:domain cidoc:E7_Activity ;
                          rdfs:range schemas:ContactPoint ;
                          rdfs:comment "Informatie zoals email, telefoon... die toelaat de aanbieder te contacteren."@nl ;
                          rdfs:label "contactinfo"@nl .


###  https://data.vlaanderen.be/ns/cultuurparticipatie#Activiteit.deelnemer
cp:Activiteit.deelnemer rdf:type owl:ObjectProperty ;
                        rdfs:domain cidoc:E7_Activity ;
                        rdfs:range cp:Participant ;
                        rdfs:comment "Participant die deelneemt aan een Activiteit."@nl ;
                        rdfs:label "deelnemer"@nl .


###  https://data.vlaanderen.be/ns/cultuurparticipatie#Activiteit.locatieType
cp:Activiteit.locatieType rdf:type owl:ObjectProperty ;
                          rdfs:domain cidoc:E7_Activity ;
                          rdfs:range skos:Concept ;
                          rdfs:comment "Het type locatie van de activiteit. Keuze tussen 'online', 'fysiek' of 'hybride'."@nl ;
                          rdfs:label "locatie type"@nl ;
                          owl:maxCardinality 1 .


###  https://data.vlaanderen.be/ns/cultuurparticipatie#Activiteit.prijs
cp:Activiteit.prijs rdf:type owl:ObjectProperty ;
                    rdfs:domain cidoc:E7_Activity ;
                    rdfs:range schemas:PriceSpecification ;
                    rdfs:comment "De Prijsinfo van de Activiteit."@nl ;
                    rdfs:label "prijs"@nl .


###  https://data.vlaanderen.be/ns/cultuurparticipatie#Activiteit.ruimtetijd
cp:Activiteit.ruimtetijd rdf:type owl:ObjectProperty ;
                         rdfs:domain cidoc:E7_Activity ;
                         rdfs:range cidoc:E92_Spacetime_Volume ;
                         rdfs:comment "Een vierdimensionele puntenreeks in de fysieke ruimtetijd waarbij er een intersectie kan zijn van een plaats en tijdsaanduiding."@nl ;
                         skos:scopeNote "Te gebruiken wanneer het niet mogelijk is om de Locatie en Tijdsaanduiding te beperken tot één waarde per Activiteit."@nl ;
                         rdfs:label "ruimtetijd"@nl .


###  https://data.vlaanderen.be/ns/cultuurparticipatie#Boekingsinfo.beschikbaar
cp:Boekingsinfo.beschikbaar rdf:type owl:ObjectProperty ;
                            rdfs:domain cp:Boekingsinfo ;
                            rdfs:range m8g:PeriodOfTime ;
                            rdfs:comment "Periode waarin de boekinginfo beschikbaar is."@nl ;
                            rdfs:label "beschikbaar"@nl .


###  https://data.vlaanderen.be/ns/cultuurparticipatie#Cultuurdeelname.themaActiviteit
cp:Cultuurdeelname.themaActiviteit rdf:type owl:ObjectProperty ;
                                   rdfs:domain cp:Cultuurdeelname ;
                                   rdfs:range skos:Concept ;
                                   rdfs:comment "Het thema van de activiteit waaraan de participant deelneemt."@nl ;
                                   rdfs:label "thema activiteit"@nl .


###  https://data.vlaanderen.be/ns/cultuurparticipatie#Cultuurdeelname.typeActiviteit
cp:Cultuurdeelname.typeActiviteit rdf:type owl:ObjectProperty ;
                                  rdfs:domain cp:Cultuurdeelname ;
                                  rdfs:range skos:Concept ;
                                  rdfs:comment "Het type activiteit waaraan de participant deelneemt."@nl ;
                                  rdfs:label "type activiteit"@nl .


###  https://data.vlaanderen.be/ns/cultuurparticipatie#Deelname.activiteit
cp:Deelname.activiteit rdf:type owl:ObjectProperty ;
                       rdfs:domain cp:Deelname ;
                       rdfs:range cidoc:E7_Activity ;
                       rdfs:comment "Referentie naar verbonden klasse."@nl ;
                       rdfs:label "Activiteit"@nl .


###  https://data.vlaanderen.be/ns/cultuurparticipatie#Deelname.inputVoor
cp:Deelname.inputVoor rdf:type owl:ObjectProperty ;
                      rdfs:domain cp:Deelname ;
                      rdfs:range cp:ParticipantProfiel ;
                      rdfs:comment "De ParticipantProfiel die gebruikt wordt als input voor de Deelname."@nl ;
                      rdfs:label "input voor"@nl .


###  https://data.vlaanderen.be/ns/cultuurparticipatie#Deelname.participant
cp:Deelname.participant rdf:type owl:ObjectProperty ;
                        rdfs:domain cp:Deelname ;
                        rdfs:range cp:Participant ;
                        rdfs:comment "De Participant die deelneemt aan de activiteit."@nl ;
                        rdfs:label "participant"@nl .


###  https://data.vlaanderen.be/ns/cultuurparticipatie#Deelname.tijdstip
cp:Deelname.tijdstip rdf:type owl:ObjectProperty ;
                     rdfs:domain cp:Deelname ;
                     rdfs:range m8g:PeriodOfTime ;
                     rdfs:comment "Het tijdstip van de deelname."@nl ;
                     rdfs:label "tijdstip"@nl .


###  https://data.vlaanderen.be/ns/cultuurparticipatie#ParticipantProfiel.algemeenKenmerk
cp:ParticipantProfiel.algemeenKenmerk rdf:type owl:ObjectProperty ;
                                      rdfs:domain cp:ParticipantProfiel ;
                                      rdfs:range cp:AlgemeenParticipantKenmerk ;
                                      rdfs:comment "Algemeen kenmerk van de participant."@nl ;
                                      rdfs:label "algemeen kenmerk"@nl .


###  https://data.vlaanderen.be/ns/cultuurparticipatie#ParticipantProfiel.cultureel
cp:ParticipantProfiel.cultureel rdf:type owl:ObjectProperty ;
                                rdfs:domain cp:ParticipantProfiel ;
                                rdfs:range cp:Cultuurdeelname ;
                                rdfs:comment "Culturele deelname-informatie van de participant."@nl ;
                                rdfs:label "cultureel"@nl .


###  https://data.vlaanderen.be/ns/cultuurparticipatie#ParticipantProfiel.sociodemografisch
cp:ParticipantProfiel.sociodemografisch rdf:type owl:ObjectProperty ;
                                        rdfs:domain cp:ParticipantProfiel ;
                                        rdfs:range cp:SociodemografischKenmerk ;
                                        rdfs:comment "Sociodemografisch kenmerk van de participant."@nl ;
                                        rdfs:label "sociodemografisch"@nl .

###  https://data.vlaanderen.be/ns/cultuurparticipatie#ParticipantProfiel.afgeleidVan
cp:ParticipantProfiel.afgeleidVan rdf:type owl:ObjectProperty ;
                                rdfs:domain cp:ParticipantProfiel ;
                                rdfs:range cp:Deelname ;
                                rdfs:comment "Deelname waarop dit participantprofiel is afgeleid."@nl ;
                                rdfs:label "afgeleid van"@nl .


###  https://data.vlaanderen.be/ns/cultuurparticipatie#Prijsinfo.prijscategorie
cp:Prijsinfo.prijscategorie rdf:type owl:ObjectProperty ;
                            rdfs:domain cp:Prijsinfo ;
                            rdfs:range skos:Concept ;
                            rdfs:comment "De categorie van de prijs zoals een jongerentarief of seniorentarief."@nl ;
                            rdfs:label "prijscategorie"@nl .

###  https://data.vlaanderen.be/ns/cultuurparticipatie#Realisator.thema
cp:Realisator.thema rdf:type owl:ObjectProperty ;
                    rdfs:domain cp:Realisator ;
                    rdfs:range skos:Concept ;
                    rdfs:comment "Het thema van de activiteiten die de Realisator uitvoert."@nl ;
                    rdfs:label "thema"@nl .


###  https://data.vlaanderen.be/ns/cultuurparticipatie#thema
cp:thema rdf:type owl:ObjectProperty ;
         rdfs:domain cidoc:E7_Activity ;
         rdfs:range skos:Concept ;
         rdfs:comment "Waar de Activiteit inhoudelijk over gaat."@nl ;
         rdfs:label "thema"@nl ;
         owl:maxCardinality 1 .


###  https://data.vlaanderen.be/ns/generiek#gestructureerdeIdentificator
generiek:gestructureerdeIdentificator rdf:type owl:ObjectProperty ;
                                      rdfs:domain adms:Identifier ;
                                      rdfs:range generiek:GestructureerdeIdentificator ;
                                      rdfs:comment "Identificator van een object opgesplitst in zijn onderdelen."@nl ;
                                      rdfs:label "gestructureerde identificator"@nl ;
                                      owl:maxCardinality 1 ;
                                      owl:minCardinality 1 .


###  https://schema.org/contactPoint
schemas:contactPoint rdf:type owl:ObjectProperty ;
                     rdfs:domain cidoc:E7_Activity ,
                                 foaf:Agent ;
                     rdfs:range schemas:ContactPoint ;
                     rdfs:comment "Informatie zoals email, telefoon... die toelaat de aanbieder te contacteren."@nl ;
                     rdfs:label "contactinfo"@nl .


###  https://schema.org/dayOfWeek
schemas:dayOfWeek rdf:type owl:ObjectProperty ;
                  rdfs:domain schemas:OpeningHoursSpecification ;
                  rdfs:range skos:Concept ;
                  rdfs:comment "De dag van de week waarop de openingstijden van toepassing zijn."@nl ;
                  rdfs:label "dag van de week"@nl .


###  https://schema.org/hoursAvailable
schemas:hoursAvailable rdf:type owl:ObjectProperty ;
                       rdfs:domain cp:Beschikbaarheid ;
                       rdfs:range schemas:OpeningHoursSpecification ;
                       rdfs:comment "De openingstijden van de beschikbaarheid."@nl ;
                       rdfs:label "openingstijden"@nl .


###  https://schema.org/price
schemas:price rdf:type owl:ObjectProperty ;
              rdfs:domain schemas:PriceSpecification ;
              rdfs:range schemas:MonetaryAmount ;
              rdfs:comment "De aanbiedingsprijs van een activiteit."@nl ;
              rdfs:label "prijs"@nl .


###  https://schema.org/value
schemas:value rdf:type owl:ObjectProperty ;
              rdfs:range schemas:Number ;
              rdfs:comment "Verwijst naar een numerieke waarde (schema.org Number)."@nl ;
              rdfs:label "waarde"@nl .


#################################################################
#    Data properties
#################################################################

###  http://data.europa.eu/m8g/endTime
m8g:endTime rdf:type owl:DatatypeProperty ;
            rdfs:range xsd:dateTime ;
            rdfs:comment "Einde vd tijdsduur."@nl ;
            rdfs:label "einde"@nl .


###  http://data.europa.eu/m8g/startTime
m8g:startTime rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:dateTime ;
              rdfs:comment "Aanvang van de tijdsduur."@nl ;
              rdfs:label "begin"@nl .


###  http://purl.org/dc/terms/created
dcterms:created rdf:type owl:DatatypeProperty ;
                rdfs:range xsd:dateTime ;
                rdfs:comment "Het tijdstip waarop de entiteit is gecreëerd."@nl ;
                rdfs:label "gecreëerd"@nl ;
                owl:maxCardinality 1 .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:DatatypeProperty ;
                    rdfs:range rdf:langString ;
                    rdfs:comment "De beschrijving van de entiteit."@nl ;
                    rdfs:label "beschrijving"@nl .


###  http://purl.org/dc/terms/modified
dcterms:modified rdf:type owl:DatatypeProperty ;
                 rdfs:range xsd:dateTime ;
                 rdfs:comment "Het tijdstip waarop de entiteit is gewijzigd."@nl ;
                 rdfs:label "gewijzigd"@nl ;
                 owl:maxCardinality 1 .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:DatatypeProperty ;
              rdfs:range rdf:langString ;
              rdfs:comment "De titel van de entiteit."@nl ;
              rdfs:label "titel"@nl ;
              owl:minCardinality 1 .


###  http://www.w3.org/2003/01/geo/wgs84_pos#lat
geo:lat rdf:type owl:DatatypeProperty ;
        rdfs:range xsd:decimal ;
        rdfs:comment "De breedtegraad."@nl ;
        rdfs:label "latitude"@nl .


###  http://www.w3.org/2003/01/geo/wgs84_pos#lon
geo:lon rdf:type owl:DatatypeProperty ;
        rdfs:range xsd:decimal ;
        rdfs:comment "De lengtegraad."@nl ;
        rdfs:label "longitude"@nl .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:DatatypeProperty ;
                rdfs:comment "Tekstuele definitie van een concept."@nl ;
                rdfs:label "definitie"@nl .


###  http://www.w3.org/2004/02/skos/core#notation
skos:notation rdf:type owl:DatatypeProperty ;
              rdfs:range xsd:anyURI ;
              rdfs:comment "Unieke identificator (URI) die de entiteit verkreeg bij registratie in het dataproduct."@nl ;
              rdfs:label "notatie"@nl .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:DatatypeProperty ;
               rdfs:range rdf:langString ;
               rdfs:comment "Naam waarmee de organisatie bij voorkeur wordt aangeduid."@nl ;
               rdfs:label "voorkeursnaam"@nl .


###  http://www.w3.org/ns/locn#adminUnitL1
locn:adminUnitL1 rdf:type owl:DatatypeProperty ;
                 rdfs:range xsd:string ;
                 rdfs:comment "De administratieve eenheid level 1 (land) van het adres."@nl ;
                 rdfs:label "administrative unit level 1"@nl .


###  http://www.w3.org/ns/locn#locatorDesignator
locn:locatorDesignator rdf:type owl:DatatypeProperty ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Het huisnummer of andere designator."@nl ;
                       rdfs:label "locator designator"@nl .


###  http://www.w3.org/ns/locn#locatorName
