# Zo ziet de data er vandaag massaal uit: foute property-URI's, ontbrekende
# kernvelden, een concept buiten de codelijst.
@prefix cidoc: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix cp:   <https://data.vlaanderen.be/ns/cultuurparticipatie#> .
@prefix dc:   <http://purl.org/dc/terms/> .
@prefix d:    <https://data.uitwisselingsplatform.be/id/> .

# foute property-URI voor ruimtetijd + label onder ongeldige namespace,
# geen titel, geen identificator, en een UiTdatabank-taxonomiecode in
# dcterms:type waar alleen officiele concepten mogen staan
d:ev-fout a cidoc:E7_Activity ;
    <https://www.w3.org/2000/01/rdf-schema#label> "Expo zonder titel"@nl ;
    dc:type <https://taxonomy.uitdatabank.be/terms/0.59.0.0.0> ;   # taxonomiecode hoort in udb:type
    cp:ruimtetijd d:ev-fout-rt ;
    cidoc:P4_has_time d:ev-fout-tijd .

# deelname zonder participant
d:dn-fout a cp:Deelname ;
    cp:Deelname.activiteit d:ev-fout .
