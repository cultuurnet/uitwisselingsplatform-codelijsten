      <https://data.cultuurparticipatie.be/id/concept/ActiviteitType/eetOfDrankfestijn>
      <https://data.cultuurparticipatie.be/id/concept/ActiviteitType/festival>
      <https://data.cultuurparticipatie.be/id/concept/ActiviteitType/festiviteit>
      <https://data.cultuurparticipatie.be/id/concept/ActiviteitType/fietsOfWandelroute>
      <https://data.cultuurparticipatie.be/id/concept/ActiviteitType/film>
      <https://data.cultuurparticipatie.be/id/concept/ActiviteitType/kampOfVakantie>
      <https://data.cultuurparticipatie.be/id/concept/ActiviteitType/kinderopvang>
      <https://data.cultuurparticipatie.be/id/concept/ActiviteitType/lessenreeks>
      <https://data.cultuurparticipatie.be/id/concept/ActiviteitType/lezingOfCongres>
      <https://data.cultuurparticipatie.be/id/concept/ActiviteitType/marktBraderieOfKermis>
      <https://data.cultuurparticipatie.be/id/concept/ActiviteitType/opendeurdag>
      <https://data.cultuurparticipatie.be/id/concept/ActiviteitType/partyOfFuif>
      <https://data.cultuurparticipatie.be/id/concept/ActiviteitType/speelpleinwerking>
      <https://data.cultuurparticipatie.be/id/concept/ActiviteitType/spelOfQuiz>
      <https://data.cultuurparticipatie.be/id/concept/ActiviteitType/sportactiviteit>
