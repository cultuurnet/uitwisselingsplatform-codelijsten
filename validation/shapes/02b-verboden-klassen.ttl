# GEGENEREERD door validation/generate_shapes.py - niet met de hand aanpassen.
# Bron: variants.json (classes)

@prefix shacl: <http://www.w3.org/ns/shacl#> .
@prefix uwpval: <https://data.uitwisselingsplatform.be/doc/validatie#> .

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# gemeten 2026-10-21: 27304
uwpval:VerbodenKlasse-Activiteit-Beschikbaarheid a shacl:NodeShape ;
  shacl:targetClass <https://data.vlaanderen.be/ns/cultuurparticipatie#Activiteit.Beschikbaarheid> ;
  shacl:property uwpval:VerbodenKlasseRegel-Activiteit-Beschikbaarheid .

uwpval:VerbodenKlasseRegel-Activiteit-Beschikbaarheid a shacl:PropertyShape ;
  shacl:path rdf:type ;
  shacl:maxCount 0 ;
  shacl:severity shacl:Violation ;
  shacl:message "Verboden class <https://data.vlaanderen.be/ns/cultuurparticipatie#Activiteit.Beschikbaarheid>. Een propertynaam met hoofdletter, gebruikt als class. Gebruik <https://data.vlaanderen.be/ns/cultuurparticipatie#Beschikbaarheid>." .

# gemeten 2026-10-21: 88483
uwpval:VerbodenKlasse-ContactPoint a shacl:NodeShape ;
  shacl:targetClass <http://schema.org/ContactPoint> ;
  shacl:property uwpval:VerbodenKlasseRegel-ContactPoint .

uwpval:VerbodenKlasseRegel-ContactPoint a shacl:PropertyShape ;
  shacl:path rdf:type ;
  shacl:maxCount 0 ;
  shacl:severity shacl:Violation ;
  shacl:message "Verboden class <http://schema.org/ContactPoint>. schema.org hoort https te zijn. Gebruik <https://schema.org/ContactPoint>." .

