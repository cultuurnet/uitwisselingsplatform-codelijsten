# gemeten 2026-10-21: 423
uwpval:VerbodenKlasse6 a shacl:NodeShape ;
  shacl:targetClass <http://www.w3.org/ns/sosa/hasResult> ;
  shacl:property [
    shacl:path rdf:type ;
    shacl:maxCount 0 ;
    shacl:severity shacl:Violation ;
    shacl:message "Verboden class <http://www.w3.org/ns/sosa/hasResult>. sosa:hasResult is een property, geen class. Er is geen vervangende class afgesproken: dit vraagt een modelleerbeslissing." ] .

